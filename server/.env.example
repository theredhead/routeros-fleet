# --- API ---
PORT=3000
CORS_ORIGIN=http://localhost:4200

# --- Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fleet
DB_PASSWORD=fleet
DB_DATABASE=fleet
DB_SYNCHRONIZE=true

# --- Secrets ---
# 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# --- RouterOS transport ---
ROUTEROS_TIMEOUT_MS=15000

# Development reset utility (always disabled when NODE_ENV=production)
DEVELOPMENT_TOOLS_ENABLED=true
